# job-platform-infra/envs/.env.prod.example
# Production template — values from secrets (not committed). Use Infisical prod env or GH Secrets.
# Azure VM prod (docker-compose.prod.yml): fill envs/.env.prod from Infisical prod, deploy with scripts/deploy.sh azure up
# Vercel web: set VITE_API_BASE_URL in Vercel dashboard

DOTNET_ENVIRONMENT=Production
JWT_SECRET=__SET_VIA_INFISICAL__
JWT_ISSUER=job-platform
JWT_AUDIENCE=job-platform
JWT_EXPIRES_MINUTES=60

# ── Data — 6 PG (MUST 5 + AI) Supabase pooled 6543 + Upstash/Bonsai/Confluent free ──
DATABASE_URL_AUTH=__SET_VIA_INFISICAL__ # pbl6-auth: postgres://user:pass@db.supabase.co:6543/job_platform_auth?sslmode=require
DATABASE_URL_JOB=__SET_VIA_INFISICAL__ # pbl6-job: postgres://.../job_platform_job?sslmode=require
DATABASE_URL_APP=__SET_VIA_INFISICAL__ # pbl6-app: postgres://.../job_platform_app?sslmode=require
DATABASE_URL_PROFILE=__SET_VIA_INFISICAL__ # pbl6-profile: postgres://.../job_platform_profile?sslmode=require
DATABASE_URL_NOTIF=__SET_VIA_INFISICAL__ # pbl6-profile or pbl6-notif: postgres://.../job_platform_notif?sslmode=require
DATABASE_URL_AI=__SET_VIA_INFISICAL__ # pbl6-ai or pbl6-app: postgres://.../job_platform_ai?sslmode=require
DATABASE_URL=__SET_VIA_INFISICAL__ # fallback infra
POSTGRES_USER=__SET_VIA_INFISICAL__
POSTGRES_PASSWORD=__SET_VIA_INFISICAL__
REDIS_URL=__SET_VIA_INFISICAL__ # Upstash redis://...
ELASTICSEARCH_URL=__SET_VIA_INFISICAL__ # Bonsai https://...
KAFKA_BOOTSTRAP_SERVERS=__SET_VIA_INFISICAL__ # Confluent

# ── Ports ──
AUTH_PORT=5001
GATEWAY_PORT=5000

# ── Gateway upstreams: docker-compose.prod.yml wires them to internal service names (http://auth:5001 ...), nothing to set ──

# ── Web (build-time URLs for the web image; replace host with the VM FQDN printed by azure-provision.sh) ──
VITE_API_URL=http://__VM_FQDN__:5000
VITE_API_BASE_URL=http://__VM_FQDN__:5000/api
VITE_WS_URL=ws://__VM_FQDN__:5000
FLUTTER_API_URL=http://__VM_FQDN__:5000

# ── AI / Storage ──
OPENAI_API_KEY=__SET_VIA_INFISICAL__
GEMINI_API_KEY=__SET_VIA_INFISICAL__
R2_ACCOUNT_ID=__SET_VIA_INFISICAL__
R2_ACCESS_KEY_ID=__SET_VIA_INFISICAL__
R2_SECRET_ACCESS_KEY=__SET_VIA_INFISICAL__
R2_BUCKET=job-platform-cvs
R2_ENDPOINT=__SET_VIA_INFISICAL__

CORS_ORIGINS=https://jp-web.vercel.app,https://jp-web-*.vercel.app,https://job-platform-web.vercel.app
LOG_LEVEL=Warning

# ── Observability (free: Grafana Cloud 10k metrics, Sentry 5k errs, UptimeRobot 50 monitors) ──
SENTRY_DSN=__SET_VIA_INFISICAL__
GRAFANA_CLOUD_URL=__SET_VIA_INFISICAL__
PROMETHEUS_URL=http://localhost:9090

# ── Compose prod (docker-compose.prod.yml / scripts/deploy.sh compose) ──
IMAGE_REGISTRY=ghcr.io/dut-pbl6-2026
IMAGE_TAG=latest # per-service override: AUTH_TAG, GATEWAY_TAG, JOB_TAG, SEARCH_TAG, APP_TAG, PROFILE_TAG, NOTIF_TAG, AI_TAG, WEB_TAG
POSTGRES_DB=job_platform
REDIS_PASSWORD=__SET_VIA_INFISICAL__
SEARCH_INDEX_TOKEN=__SET_VIA_INFISICAL__
PROFILE_ENCRYPTION_KEY=__SET_VIA_INFISICAL__
SMTP_HOST=__SET_VIA_INFISICAL__
SMTP_PORT=587
SMTP_USER=__SET_VIA_INFISICAL__
SMTP_PASS=__SET_VIA_INFISICAL__
SMTP_FROM=noreply@job-platform.local
WEB_PORT=80
GATEWAY_BIND=0.0.0.0 # 127.0.0.1 when a TLS reverse proxy runs on the same host

# ── Azure (scripts/azure-provision.sh + scripts/deploy.sh azure; shell env, not read by compose) ──
AZURE_SUBSCRIPTION_ID=__SET_VIA_INFISICAL__ # optional; rotate per student subscription
AZURE_RESOURCE_GROUP=rg-jobplatform
AZURE_VM_NAME=vm-jobplatform
AZURE_VM_SSH_USER=azureuser
AZURE_SSH_KEY=~/.ssh/id_ed25519 # path to private key (never commit)
AZURE_LOCATION=southeastasia # check student-allowed regions: az vm list-skus
AZURE_ADMIN_CIDR=__SET_VIA_INFISICAL__ # your public IP /32 for SSH
GHCR_USER=__SET_VIA_INFISICAL__ # only if GHCR packages are private
GHCR_TOKEN=__SET_VIA_INFISICAL__ # PAT read:packages
