# job-platform-infra/envs/.env.prod.example
# Production template — values from secrets (not committed). Use Infisical prod env or GH Secrets.
# Render prod: set via Render Dashboard Environment + Deploy Hook secrets RENDER_DEPLOY_HOOK_*
# Vercel web: set VITE_API_BASE_URL in Vercel dashboard

DOTNET_ENVIRONMENT=Production
JWT_SECRET=__SET_VIA_INFISICAL__
JWT_ISSUER=job-platform
JWT_AUDIENCE=job-platform
JWT_EXPIRES_MINUTES=60

# ── Data — 6 PG (MUST 5 + AI) Supabase pooled 6543 + Upstash/Bonsai/Confluent free ──
DATABASE_URL_AUTH=__SET_VIA_INFISICAL__ # pbl6-auth: postgres://user:pass@db.supabase.co:6543/job_platform_auth
DATABASE_URL_JOB=__SET_VIA_INFISICAL__ # pbl6-job: postgres://.../job_platform_job
DATABASE_URL_APP=__SET_VIA_INFISICAL__ # pbl6-app: postgres://.../job_platform_app
DATABASE_URL_PROFILE=__SET_VIA_INFISICAL__ # pbl6-profile: postgres://.../job_platform_profile
DATABASE_URL_NOTIF=__SET_VIA_INFISICAL__ # pbl6-profile or pbl6-notif: postgres://.../job_platform_notif
DATABASE_URL_AI=__SET_VIA_INFISICAL__ # pbl6-ai or pbl6-app: postgres://.../job_platform_ai
DATABASE_URL=__SET_VIA_INFISICAL__ # fallback infra
POSTGRES_USER=__SET_VIA_INFISICAL__
POSTGRES_PASSWORD=__SET_VIA_INFISICAL__
REDIS_URL=__SET_VIA_INFISICAL__ # Upstash redis://...
ELASTICSEARCH_URL=__SET_VIA_INFISICAL__ # Bonsai https://...
KAFKA_BOOTSTRAP_SERVERS=__SET_VIA_INFISICAL__ # Confluent

# ── Ports (Render) ──
AUTH_PORT=5001
GATEWAY_PORT=5000

# ── Gateway upstreams (Render public URLs — Free no private network, short jp-*) ──
GATEWAY_UPSTREAM_AUTH=https://jp-auth.onrender.com
GATEWAY_UPSTREAM_JOB=https://jp-job.onrender.com
GATEWAY_UPSTREAM_SEARCH=https://jp-search.onrender.com
GATEWAY_UPSTREAM_APP=https://jp-app.onrender.com
GATEWAY_UPSTREAM_PROFILE=https://jp-profile.onrender.com
GATEWAY_UPSTREAM_NOTIF=https://jp-notif.onrender.com

# ── Web (Vercel jp-web) ──
VITE_API_URL=https://jp-gateway.onrender.com
VITE_API_BASE_URL=https://jp-gateway.onrender.com/api
VITE_WS_URL=wss://jp-gateway.onrender.com
FLUTTER_API_URL=https://jp-gateway.onrender.com

# ── AI / Storage ──
OPENAI_API_KEY=__SET_VIA_INFISICAL__
GEMINI_API_KEY=__SET_VIA_INFISICAL__
R2_ACCOUNT_ID=__SET_VIA_INFISICAL__
R2_ACCESS_KEY_ID=__SET_VIA_INFISICAL__
R2_SECRET_ACCESS_KEY=__SET_VIA_INFISICAL__
R2_BUCKET=job-platform-cvs
R2_ENDPOINT=__SET_VIA_INFISICAL__

CORS_ORIGINS=https://jp-web.vercel.app,https://jp-web-*.vercel.app,https://job-platform-web.vercel.app
LOG_LEVEL=Warning

# ── Observability (free: Grafana Cloud 10k metrics, Sentry 5k errs, UptimeRobot 50 monitors) ──
SENTRY_DSN=__SET_VIA_INFISICAL__
GRAFANA_CLOUD_URL=__SET_VIA_INFISICAL__
PROMETHEUS_URL=http://localhost:9090
