# job-platform-infra/envs/.env.dev.example
# Single source of truth for local dev (gitignored .env generated via scripts/sync-env.sh)
# Copy to 14 repos via: make sync-env  (or ./scripts/sync-env.sh dev)
# See docs/master-plan.md:149,196,222,271

# ── Shared (job-platform-shared NuGet, all svcs) ──
DOTNET_ENVIRONMENT=Development
JWT_SECRET=dev-jwt-secret-change-me-32chars-min
JWT_ISSUER=job-platform
JWT_AUDIENCE=job-platform
JWT_EXPIRES_MINUTES=60

# ── Data Layer ──
DATABASE_URL=Host=localhost;Port=5432;Database=job_platform;Username=postgres;Password=postgres
DATABASE_URL_AUTH=Host=localhost;Port=5432;Database=job_platform_auth;Username=postgres;Password=postgres
DATABASE_URL_JOB=Host=localhost;Port=5432;Database=job_platform_job;Username=postgres;Password=postgres
DATABASE_URL_APP=Host=localhost;Port=5432;Database=job_platform_app;Username=postgres;Password=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=job_platform

REDIS_URL=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=jobs

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_JOB_EVENTS=job-events
KAFKA_TOPIC_APPLICATION_EVENTS=application-events
KAFKA_GROUP_ID=job-platform

# ── Auth Service (PBL6-12,13) TM1 ──
AUTH_PORT=5001
AUTH_CONNECTION_STRING=${DATABASE_URL_AUTH}

# ── Job Service (PBL6-17) TM2 ──
JOB_PORT=5002
JOB_CONNECTION_STRING=${DATABASE_URL_JOB}

# ── Search Service (PBL6-18,19,39) TM2 ──
SEARCH_PORT=5003
SEARCH_ES_URL=${ELASTICSEARCH_URL}
SEARCH_REDIS_URL=${REDIS_URL}

# ── App Service (PBL6-23) TM1 ──
APP_PORT=5004
APP_CONNECTION_STRING=${DATABASE_URL_APP}
APP_CV_STORAGE_PATH=./storage/cvs

# ── Profile Service (PBL6-24) TM2 ──
PROFILE_PORT=5005
PROFILE_CONNECTION_STRING=${DATABASE_URL}

# ── Notif Service (PBL6-35) TM1 ──
NOTIF_PORT=5006
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@job-platform.local

# ── Gateway YARP (PBL6-29) TM1 ──
GATEWAY_PORT=5000
GATEWAY_UPSTREAM_AUTH=http://localhost:5001
GATEWAY_UPSTREAM_JOB=http://localhost:5002
GATEWAY_UPSTREAM_SEARCH=http://localhost:5003
GATEWAY_UPSTREAM_APP=http://localhost:5004
GATEWAY_UPSTREAM_PROFILE=http://localhost:5005
GATEWAY_UPSTREAM_NOTIF=http://localhost:5006

# ── Web (PBL6-14 etc) TM3 ──
VITE_API_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000

# ── Mobile (PBL6-15 etc) TM4 ──
FLUTTER_API_URL=http://localhost:5000

# ── Crawler (PBL6-30,31) TM2 ──
CRAWLER_TARGET=https://vieclam.gov.vn
CRAWLER_CONCURRENCY=4
CRAWLER_DELAY=1

# ── AI (PBL6-55,56,60) TM2 — NICE TO HAVE, set when Sprint 5 ──
AI_PORT=6000
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_VECTOR_STORE=elasticsearch

# ── Infra / Monitoring (PBL6-49,51,52) TM1 ──
SEQ_URL=http://localhost:5341
GRAFANA_URL=http://localhost:3000
PROMETHEUS_URL=http://localhost:9090

# ── File Storage (Cloudflare R2) SHOULD HAVE ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=job-platform-cvs
R2_ENDPOINT=

# ── Misc ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=Information
